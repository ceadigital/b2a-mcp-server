{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.ceadigital/b2a-fulfillment-factory",
  "title": "CEA Digital B2A Institutional MCP Server & x402 Gateway",
  "description": "Sub-ms MCP Server & x402 Gateway for SEC EDGAR, crt.sh, EPSS, GLEIF, CFPB, FDIC, NPI, USGS & GCP.",
  "websiteUrl": "https://ceadigital.io",
  "repository": {
    "url": "https://github.com/ceadigital/b2a-mcp-server",
    "source": "github"
  },
  "version": "1.0.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://ceadigital.io/mcp"
    },
    {
      "type": "streamable-http",
      "url": "https://ceadigital.io/mcp/crtsh"
    },
    {
      "type": "streamable-http",
      "url": "https://ceadigital.io/mcp/epss"
    },
    {
      "type": "streamable-http",
      "url": "https://ceadigital.io/mcp/sec-edgar"
    },
    {
      "type": "streamable-http",
      "url": "https://ceadigital.io/mcp/gleif"
    },
    {
      "type": "streamable-http",
      "url": "https://ceadigital.io/mcp/cfpb"
    },
    {
      "type": "streamable-http",
      "url": "https://ceadigital.io/mcp/usaspending"
    },
    {
      "type": "streamable-http",
      "url": "https://ceadigital.io/mcp/fdic"
    },
    {
      "type": "streamable-http",
      "url": "https://ceadigital.io/mcp/gcp-catalog"
    },
    {
      "type": "streamable-http",
      "url": "https://ceadigital.io/mcp/dexscreener"
    },
    {
      "type": "streamable-http",
      "url": "https://ceadigital.io/mcp/npi"
    },
    {
      "type": "streamable-http",
      "url": "https://ceadigital.io/mcp/openalex"
    },
    {
      "type": "streamable-http",
      "url": "https://ceadigital.io/mcp/usgs"
    }
  ],
  "tools": [
    {
      "name": "gcp_catalog_search",
      "description": "Sub-millisecond FTS5 search across 17,671 Google Cloud, Vertex AI, Billing SKUs, and A2A service records.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "FTS5 search term (e.g. 'compute engine', 'vertex rag')"
          },
          "limit": {
            "type": "integer",
            "description": "Max results to return (default 10)",
            "default": 10
          }
        },
        "required": ["query"]
      }
    },
    {
      "name": "vault_knowledge_search",
      "description": "FTS5 search across 36,628 video transcript chunks and 106,308 knowledge graph triples in vault.db.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search term for creator knowledge graph"
          },
          "limit": {
            "type": "integer",
            "description": "Max chunk results (default 10)",
            "default": 10
          }
        },
        "required": ["query"]
      }
    },
    {
      "name": "sec_edgar_cik_lookup",
      "description": "SEC EDGAR company facts, quarterly filings, and CIK lookup under Lowe v. SEC Publisher's Exclusion.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "description": "Stock ticker symbol (e.g. 'AAPL', 'MSFT')"
          },
          "cik": {
            "type": "string",
            "description": "Ten-digit SEC Central Index Key (e.g. '0000320193')"
          }
        }
      }
    },
    {
      "name": "github_repo_pulse",
      "description": "GitHub repository activity metrics, stars, forks, and open issues with conditional ETag HTTP 304 caching.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner or organization (e.g. 'fastapi')"
          },
          "repo": {
            "type": "string",
            "description": "Repository name (e.g. 'fastapi')"
          }
        },
        "required": ["owner", "repo"]
      }
    },
    {
      "name": "security_cve_audit",
      "description": "Audit package vulnerabilities and CVE advisories via OSV.dev and FIRST.org EPSS exploit scoring.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "package": {
            "type": "string",
            "description": "Package name (e.g. 'jinja2', 'requests')"
          },
          "ecosystem": {
            "type": "string",
            "description": "Ecosystem (PyPI, npm, Go, etc.)",
            "default": "PyPI"
          },
          "version": {
            "type": "string",
            "description": "Specific version string (optional)"
          }
        },
        "required": ["package"]
      }
    },
    {
      "name": "package_health_pulse",
      "description": "Parallel health pulse inspection across NPM and PyPI ecosystems.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "package_name": {
            "type": "string",
            "description": "Target package name"
          }
        },
        "required": ["package_name"]
      }
    },
    {
      "name": "fdic_bank_health",
      "description": "Factual public supervisory bank health and branch metrics compiled from FDIC under 12 CFR Part 328.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cert_or_name": {
            "type": "string",
            "description": "FDIC certificate number or bank name (e.g. '628' or 'JPMorgan Chase')"
          }
        },
        "required": ["cert_or_name"]
      }
    },
    {
      "name": "openalex_citation_graph",
      "description": "Scholarly citation network and academic research metadata via OpenAlex API (CC0).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search term for scholarly papers"
          },
          "doi": {
            "type": "string",
            "description": "Digital Object Identifier (e.g. '10.1038/s41586-020-2649-2')"
          }
        }
      }
    },
    {
      "name": "usgs_seismic_hazard",
      "description": "Real-time earthquake hazards and seismic probability from USGS Earthquake Hazards Program.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "description": "Latitude coordinate (-90 to 90)"
          },
          "longitude": {
            "type": "number",
            "description": "Longitude coordinate (-180 to 180)"
          },
          "radius_km": {
            "type": "number",
            "description": "Search radius in km (default 100.0)",
            "default": 100.0
          },
          "minmagnitude": {
            "type": "number",
            "description": "Minimum earthquake magnitude (default 2.5)",
            "default": 2.5
          }
        }
      }
    },
    {
      "name": "dexscreener_token_audit",
      "description": "Decentralized exchange liquidity, pair volume, and pricing audit via DexScreener.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "token_address": {
            "type": "string",
            "description": "Base or Ethereum token contract address (0x...)"
          },
          "chain_id": {
            "type": "string",
            "description": "Blockchain network (default 'base')",
            "default": "base"
          }
        },
        "required": ["token_address"]
      }
    },
    {
      "name": "npi_medical_registry",
      "description": "CMS NPPES NPI-2 organizational healthcare provider lookup (HIPAA safe-harbor).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "organization_name": {
            "type": "string",
            "description": "Healthcare organization or provider group name"
          },
          "npi_number": {
            "type": "string",
            "description": "Ten-digit NPI-2 organizational provider number"
          }
        }
      }
    },
    {
      "name": "crtsh_cert_recon",
      "description": "Sectigo Certificate Transparency logs & subdomain reconnaissance via crt.sh.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "Target domain name (e.g. 'stripe.com')"
          }
        },
        "required": ["domain"]
      }
    },
    {
      "name": "epss_exploit_score",
      "description": "FIRST.org Exploit Prediction Scoring System 30-day real-world CVE exploit probability score.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cve": {
            "type": "string",
            "description": "Common Vulnerabilities and Exposures ID (e.g. 'CVE-2024-3094')"
          }
        },
        "required": ["cve"]
      }
    },
    {
      "name": "gleif_lei_kyb",
      "description": "Global Legal Entity Identifier (GLEIF) corporate KYB and jurisdiction verification.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Corporate legal entity name (e.g. 'Coinbase')"
          }
        },
        "required": ["name"]
      }
    },
    {
      "name": "cfpb_complaints",
      "description": "CFPB consumer financial complaint audit (17 U.S.C. § 105 federal public domain).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string",
            "description": "Financial institution or company name (e.g. 'Equifax')"
          }
        },
        "required": ["company"]
      }
    },
    {
      "name": "usaspending_awards",
      "description": "USASpending.gov federal contract awards and contractor recipient intelligence.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "recipient": {
            "type": "string",
            "description": "Federal contractor or grant recipient name (e.g. 'Palantir')"
          }
        },
        "required": ["recipient"]
      }
    },
    {
      "name": "submit_mcp_feedback_or_request",
      "description": "Free interactive MCP schema feedback, feature requests, quality ratings, and rate quote negotiation hook.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mcp_target": {
            "type": "string",
            "description": "Target MCP server or endpoint (e.g. 'io.ceadigital/crtsh-cert-transparency', '/v1/extract/epss-exploit-score', or 'New MCP Request')",
            "default": "io.ceadigital/b2a-fulfillment-factory"
          },
          "category": {
            "type": "string",
            "description": "Category: 'mcp_improvement', 'new_mcp_request', 'pricing_rate_quote', or 'compliance_privacy_note'",
            "default": "mcp_improvement"
          },
          "desired_rate_usd": {
            "type": "string",
            "description": "Preferred per-call rate or compute pool tier (e.g. '$0.005/call', '$0.010/call', '$0.020/call')",
            "default": "$0.010/call (Daemon Pool)"
          },
          "rating": {
            "type": "integer",
            "description": "MCP utility/speed rating from 1 to 5",
            "default": 5
          },
          "message": {
            "type": "string",
            "description": "Feedback on MCP schema/quality, missing fields, or custom endpoint request"
          },
          "agent_or_contact": {
            "type": "string",
            "description": "Agent identifier, GitHub handle, or contact channel (optional)",
            "default": "anonymous-agent"
          }
        },
        "required": ["message"]
      }
    }
  ]
}
